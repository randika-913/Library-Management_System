            <Label layoutX="26.0" layoutY="31.0" text="Book ID" textAlignment="CENTER">
               <font>
                  <Font name="Times New Roman Bold Italic" size="18.0" />
               </font>
            </Label>
            <Label layoutX="23.0" layoutY="72.0" text="Book Title " textAlignment="CENTER">
               <font>
                  <Font name="Times New Roman Bold Italic" size="18.0" />
               </font>
            </Label>
            <Label layoutX="23.0" layoutY="113.0" text="Author" textAlignment="CENTER">
               <font>
                  <Font name="Times New Roman Bold Italic" size="18.0" />
